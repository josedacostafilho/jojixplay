{
  "name": "jojixplay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "verify:assets": "node scripts/verify-model.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run verify:assets && npm run build",
    "validate": "npm run check && npm run test:e2e && npm run audit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "trystero": "0.25.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  }
}
