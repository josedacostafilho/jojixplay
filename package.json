{
  "name": "jojixplay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build --workspace @jojixplay/desenhar && npm run build --workspace @jojixplay/corrida && npm run build --workspace @jojixplay/swinging",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "test": "vitest run && npm test --workspace @jojixplay/desenhar && npm test --workspace @jojixplay/corrida && npm test --workspace @jojixplay/swinging",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "check": "npm run verify:toolchain && npm run verify:boundaries && npm run format:check && npm run lint && npm run test && npm run verify:assets && npm run build",
    "validate": "npm run check && npm run test:e2e && npm run audit",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "dev:draw": "npm run dev --workspace @jojixplay/desenhar",
    "dev:race": "npm run dev --workspace @jojixplay/corrida",
    "dev:swinging": "npm run dev --workspace @jojixplay/swinging"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/three": "0.186.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ]
}
